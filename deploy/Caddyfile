tocca-beauty.ru, www.tocca-beauty.ru {
 encode gzip

 @api path /api/*
 handle @api {
  reverse_proxy api:3000
 }

 @socket path /socket.io/*
 handle @socket {
  reverse_proxy api:3000
 }

 @media path /avatar/* /home-services/* /img/* /portfolio/* /promotions/* /uploads/*
 handle @media {
  reverse_proxy api:3000
 }

 handle {
  reverse_proxy web:3000
 }
}
